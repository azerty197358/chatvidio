{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://chatvidio.onrender.com/api/:path*" },
    { "source": "/:path*", "destination": "https://chatvidio.onrender.com/:path*" }
  ]
}
