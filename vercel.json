{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": false,
  "functions": {
    "api/[...path].js": { "maxDuration": 120 }
  },
  "rewrites": [
    { "source": "/:path*", "destination": "https://chatvidio.onrender.com/:path*" }
  ]
}
