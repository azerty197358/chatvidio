# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Credentials
SUPABASE_URL=""
SUPABASE_KEY=""
# Optional but recommended: service_role key (bypasses RLS for server-side writes)
SUPABASE_SERVICE_ROLE_KEY=""

# Security and Auth Settings
JWT_SECRET="zoomdz_secret_key_2024_for_testing_only"

# Telegram Bot & Channel Verification
TELEGRAM_BOT_TOKEN="7691722011:AAFcsFzRtiSPwmi1UoL6n3yDl0tl_v09Qbs"
TELEGRAM_CHANNEL="@zoomdz1"

# CORS Origin Config
CORS_ORIGIN=""

# ============================================================
# Email service — Brevo (أساسي) + Resend (احتياطي)
# مطلوب لـ: كود التحقق لطلب السحب، استعادة كلمة المرور، الإشعارات
# اضبط مفتاحاً على الأقل — بدون أحدهما لا يُرسل أي بريد إطلاقاً.
# أضفها في: Render → الخدمة → Environment → Save (يُعيد النشر تلقائياً)
# ============================================================
# Brevo: https://app.brevo.com → Settings → SMTP & API → API Keys
# ⚠️ إذا كان "Authorized IPs" مفعلاً في إعدادات الأمان، ألغِ تفعيله (عناوين IP تتغير)
BREVO_API_KEY=""
# اختياري: بريد واسم المرسل (يجب أن يكونا مُوثَّقين في Brevo)
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME=""

# Resend بديل: https://resend.com/api-keys — يتطلب توثيق نطاق zoomdz.com (DNS)
RESEND_API_KEY=""
# اختياري (القيم الافتراضية كما يلي)
RESEND_SENDER_EMAIL="no-reply@zoomdz.com"
RESEND_SENDER_NAME="ZoomDz"
RESEND_SENDER_DOMAIN="zoomdz.com"

# الرابط العام للمنصة كما يظهر داخل الروابط بالبريد
PLATFORM_URL="https://zoomdz.com"

# Google OAuth Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_PROJECT_ID="cedar-channel-507807-e0"

#  البث المباشر: WebRTC مع إشارة عبر Pusher.com
#  القيم التالية افتراضية ومضمّنة أيضاً في utils/pusher.js — تُضبط من البيئة لتجاوزها.
#  ملاحظة: مفتاح القناتين (KEY) عام وآمن في المتصفح، والسرّ (SECRET) يبقى على الخادم فقط.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="eu"